{
  "name": "artifactpassport",
  "version": "0.1.0",
  "private": true,
  "description": "Privacy-first identity, integrity, QA, and device handoff for AI-generated artifacts.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "audit": "npm audit --omit=dev"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "typescript": "^5.8.3",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
